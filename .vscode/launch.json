{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Load knowledge-base documents",
      "type": "debugpy",
      "request": "launch",
      "module": "src.ingestion.load_documents",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
